# Copy to .env (or .env.local for local dev) and fill in.
# Both .env and .env.local are gitignored — never commit real credentials.
#
# Local development default (no auth, as installed by MongoDB Community):
MONGODB_URI=mongodb://127.0.0.1:27017

# When the VedryxTech cluster credentials are issued, replace the line above with
# the connection string, keeping the password out of source control:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=vedryxtech

PORT=3000

# Resend transactional-email API. https://resend.com/api-keys
RESEND_API_KEY=API_KEY_HERE
SALES_FROM=sales@team.vedryxtech.com
SALES_CC=we@vedryxtech.com
